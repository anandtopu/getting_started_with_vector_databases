# Local development only. All Docker ports bind to 127.0.0.1.
MARLOWE_DATA_DIR=data
MARLOWE_CACHE_DIR=.cache/marlowe
MARLOWE_POSTGRES_URL=postgresql://marlowe:marlowe-local@127.0.0.1:5432/marlowe
MARLOWE_QDRANT_URL=http://127.0.0.1:6333
MARLOWE_WEAVIATE_HOST=127.0.0.1
MARLOWE_WEAVIATE_PORT=8080
MARLOWE_WEAVIATE_GRPC_PORT=50051
MARLOWE_MILVUS_URL=http://127.0.0.1:19530
MARLOWE_OLLAMA_URL=http://127.0.0.1:11434
MARLOWE_OLLAMA_MODEL=qwen3:0.6b
MARLOWE_ELASTICSEARCH_URL=http://127.0.0.1:9200
MARLOWE_REDIS_URL=redis://127.0.0.1:6379
MARLOWE_MONGODB_URL=mongodb://marlowe:marlowe-local@127.0.0.1:27017/?directConnection=true
MARLOWE_VESPA_URL=http://127.0.0.1:8081

# Tier 4 local application backend: tinyvec, qdrant-local, sqlite-vec, or a prepared server
MARLOWE_APP_BACKEND=tinyvec
